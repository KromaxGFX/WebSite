{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clave": {
      "type": "string"
    },
    "nombre": {
      "type": "string"
    },
    "lema": {
      "type": "string"
    },
    "rol": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "activo",
        "mantenimiento",
        "archivado"
      ]
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repositorio": {
      "type": "string",
      "format": "uri"
    },
    "licencia": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "orden": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "aspectos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "descripcion": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "clave",
    "nombre",
    "lema",
    "rol",
    "estado",
    "stack",
    "repositorio",
    "licencia"
  ]
}