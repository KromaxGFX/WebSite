---
/**
 * Ficha de proyecto reutilizable.
 *
 * @prop proyecto - Entrada de la colección `proyectos`
 * @prop detallado - Si es true, muestra descripción y aspectos
 */

interface Props {
  proyecto: any;
  detallado?: boolean;
}

const { proyecto, detallado = false } = Astro.props;
const { data } = proyecto;
const colorProyecto = data.color || '#64789b';
---

<article class="ficha" style={`--color-proyecto: ${colorProyecto};`}>
  <header class="ficha__cabecera">
    <div class="ficha__marca">
      <span class="ficha__punto" aria-hidden="true"></span>
      <h2 class="ficha__nombre">{data.nombre}</h2>
    </div>
    <span class="ficha__estado ficha__estado--{data.estado}">{data.estado}</span>
  </header>

  <p class="ficha__lema">{data.lema}</p>

  {detallado && data.descripcion && <p class="ficha__descripcion">{data.descripcion}</p>}

  <footer class="ficha__pie">
    <div class="ficha__stack">
      {data.stack.map((tech: string) => <span class="ficha__tech">{tech}</span>)}
    </div>
    <a class="ficha__enlace" href={data.repositorio} target="_blank" rel="noreferrer noopener">
      Ver repositorio
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </footer>

  {detallado && data.aspectos && data.aspectos.length > 0 && (
    <ul class="ficha__aspectos">
      {data.aspectos.map((aspecto: string) => <li>{aspecto}</li>)}
    </ul>
  )}
</article>

<style>
  .ficha {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--border-width) solid var(--border);
    border-block-start: 3px solid var(--color-proyecto);
    background: var(--surface);
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .ficha:hover {
    border-color: var(--border-strong);
  }

  .ficha__cabecera {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .ficha__marca {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
  }

  .ficha__punto {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-block-start: 0.375rem;
    border-radius: 50%;
    background: var(--color-proyecto);
  }

  .ficha__nombre {
    font-size: var(--text-lg);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ficha__estado {
    flex: none;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ficha__estado--activo {
    color: var(--accent-300);
    background: var(--accent-contrast);
  }

  .ficha__estado--mantenimiento {
    color: var(--steel-400);
    background: rgba(100, 120, 155, 0.15);
  }

  .ficha__estado--archivado {
    color: var(--text-subtle);
    background: var(--surface-inset);
  }

  .ficha__lema {
    margin: 0;
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: var(--leading-snug);
  }

  .ficha__descripcion {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }

  .ficha__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-start: var(--space-3);
    margin-block-start: var(--space-2);
    border-block-start: var(--border-width) solid var(--border-subtle);
  }

  .ficha__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .ficha__tech {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-subtle);
    background: var(--surface-inset);
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--border-subtle);
  }

  .ficha__enlace {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .ficha__enlace:hover {
    color: var(--accent);
  }

  .ficha__aspectos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .ficha__aspectos li {
    position: relative;
    padding-inline-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .ficha__aspectos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-proyecto);
  }
</style>