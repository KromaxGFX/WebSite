---
/**
 * Conmutador de tema (claro/oscuro).
 *
 * Persiste la eleccion en localStorage y respeta prefers-color-scheme
 * como valor por defecto.
 */
---

<button
  type="button"
  class="tema"
  id="tema-boton"
  aria-label="Cambiar tema"
  title="Cambiar tema"
  aria-pressed="false"
>
  <svg class="tema__icono tema__icono--sol" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></circle>
    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <svg class="tema__icono tema__icono--luna" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  .tema {
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--border);
    color: var(--text-muted);
    background: transparent;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .tema:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .tema__icono {
    display: none;
  }

  :root:not([data-theme='light']) .tema__icono--sol,
  :root[data-theme='light'] .tema__icono--luna {
    display: block;
  }
</style>

<script>
  const boton = document.getElementById('tema-boton') as HTMLButtonElement | null;
  const KEY = 'kromax-tema';

  function aplicar(tema: 'light' | 'dark'): void {
    document.documentElement.dataset.theme = tema;
    document.documentElement.style.colorScheme = tema;
    boton?.setAttribute('aria-pressed', String(tema === 'light'));
  }

  function inicializar(): void {
    try {
      const guardado = localStorage.getItem(KEY);
      const preferencia = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      const tema = (guardado === 'light' || guardado === 'dark') ? guardado : preferencia;
      aplicar(tema);
    } catch {
      aplicar('dark');
    }
  }

  boton?.addEventListener('click', () => {
    const actual = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    const siguiente = actual === 'light' ? 'dark' : 'light';
    try {
      localStorage.setItem(KEY, siguiente);
    } catch { /* ignorar */ }
    aplicar(siguiente);
  });

  // Sincronizar con cambios del sistema si el usuario no ha elegido
  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
    try {
      if (!localStorage.getItem(KEY)) {
        aplicar(e.matches ? 'light' : 'dark');
      }
    } catch { /* ignorar */ }
  });

  inicializar();
</script>